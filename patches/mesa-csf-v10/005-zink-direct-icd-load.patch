From: onn field port (Walmart onn 4K Pro Gen 2, Mali-G310v2 MC1, kbase r44p1 CSF UK 1.20)
Subject: [PATCH csf-v10 005] zink: load the Vulkan ICD directly when there is no loader (ZINK_VK_ICD)

The bundled bionic arm64 runtime has no libvulkan loader. If VK_LIBNAME fails 
to load, dlopen the ICD named by ZINK_VK_ICD, take vk_icdGetInstanceProcAddr, 
and resolve vkGetDeviceProcAddr through the GIPA once the instance exists.

diff --git a/src/gallium/drivers/zink/zink_screen.c b/src/gallium/drivers/zink/zink_screen.c
index 9bb41fc2ade..26e8a46c31e 100644
--- a/src/gallium/drivers/zink/zink_screen.c
+++ b/src/gallium/drivers/zink/zink_screen.c
@@ -3482,6 +3482,14 @@ zink_internal_create_screen(const struct pipe_screen_config *config, int64_t dev
    u_trace_state_init();
 
    screen->loader_lib = util_dl_open(VK_LIBNAME);
+   /* No Vulkan loader on this target (bionic, single ICD): fall back to
+    * dlopen'ing the ICD directly via ZINK_VK_ICD. ICD interface 1.1 serves the
+    * global entry points through vk_icdGetInstanceProcAddr(NULL, ...). */
+   if (!screen->loader_lib) {
+      const char *icd = os_get_option("ZINK_VK_ICD");
+      if (icd)
+         screen->loader_lib = util_dl_open(icd);
+   }
    if (!screen->loader_lib) {
       if (!screen->driver_name_is_inferred)
          mesa_loge("ZINK: failed to load "VK_LIBNAME);
@@ -3489,9 +3497,13 @@ zink_internal_create_screen(const struct pipe_screen_config *config, int64_t dev
    }
 
    screen->vk_GetInstanceProcAddr = (PFN_vkGetInstanceProcAddr)util_dl_get_proc_address(screen->loader_lib, "vkGetInstanceProcAddr");
+   if (!screen->vk_GetInstanceProcAddr)
+      screen->vk_GetInstanceProcAddr = (PFN_vkGetInstanceProcAddr)util_dl_get_proc_address(screen->loader_lib, "vk_icdGetInstanceProcAddr");
    screen->vk_GetDeviceProcAddr = (PFN_vkGetDeviceProcAddr)util_dl_get_proc_address(screen->loader_lib, "vkGetDeviceProcAddr");
-   if (!screen->vk_GetInstanceProcAddr ||
-       !screen->vk_GetDeviceProcAddr) {
+   /* ICD exports no vkGetDeviceProcAddr symbol; resolve it through the GIPA. */
+   if (!screen->vk_GetDeviceProcAddr && screen->vk_GetInstanceProcAddr)
+      screen->vk_GetDeviceProcAddr = (PFN_vkGetDeviceProcAddr)screen->vk_GetInstanceProcAddr(NULL, "vkGetDeviceProcAddr");
+   if (!screen->vk_GetInstanceProcAddr) {
       if (!screen->driver_name_is_inferred)
          mesa_loge("ZINK: failed to get proc address");
       goto fail;
@@ -3523,6 +3535,16 @@ zink_internal_create_screen(const struct pipe_screen_config *config, int64_t dev
    screen->instance_info = &instance_info;
    simple_mtx_unlock(&instance_lock);
 
+   /* The ICD exports no vkGetDeviceProcAddr symbol and GIPA(NULL,...) cannot
+    * return it; fetch it now that we have an instance, before any device-
+    * entrypoint load. */
+   if (!screen->vk_GetDeviceProcAddr)
+      screen->vk_GetDeviceProcAddr = (PFN_vkGetDeviceProcAddr)screen->vk_GetInstanceProcAddr(screen->instance, "vkGetDeviceProcAddr");
+   if (!screen->vk_GetDeviceProcAddr) {
+      mesa_loge("zink: no vkGetDeviceProcAddr from ICD");
+      goto fail;
+   }
+
    if (zink_debug & ZINK_DEBUG_VALIDATION) {
       if (!screen->instance_info->have_layer_KHRONOS_validation &&
           !screen->instance_info->have_layer_LUNARG_standard_validation) {
