diff --git a/src/pc/gfx/gfx_sdl2.c b/src/pc/gfx/gfx_sdl2.c
index 243a704..01c1286 100644
--- a/src/pc/gfx/gfx_sdl2.c
+++ b/src/pc/gfx/gfx_sdl2.c
@@ -153,7 +153,11 @@ static void gfx_sdl_reset_dimension_and_pos(void) {
 static void gfx_sdl_init(const char *window_title) {
     SDL_Init(SDL_INIT_VIDEO);
 
+#ifdef USE_GLES
+    SDL_GL_SetAttribute(SDL_GL_DEPTH_SIZE, 0);  // onn: surfaceless pbuffer has no depth config; depth comes from the ONNM4 present FBO's depth renderbuffer
+#else
     SDL_GL_SetAttribute(SDL_GL_DEPTH_SIZE, 24);
+#endif
     SDL_GL_SetAttribute(SDL_GL_DOUBLEBUFFER, 1);
 
     #ifdef USE_GLES
@@ -167,13 +171,22 @@ static void gfx_sdl_init(const char *window_title) {
 
     int xpos = (configWindow.x == WAPI_WIN_CENTERPOS) ? SDL_WINDOWPOS_CENTERED : configWindow.x;
     int ypos = (configWindow.y == WAPI_WIN_CENTERPOS) ? SDL_WINDOWPOS_CENTERED : configWindow.y;
+#ifdef USE_GLES
+    xpos = 0; ypos = 0;  // onn: the offscreen/headless driver has no display; SDL_WINDOWPOS_CENTERED -> SDL_CreateWindow NULL ("Invalid window")
+#endif
 
     wnd = SDL_CreateWindow(
         window_title,
         xpos, ypos, configWindow.w, configWindow.h,
+#ifdef USE_GLES
+        SDL_WINDOW_OPENGL  // onn: the offscreen/headless video driver rejects SHOWN|RESIZABLE -> SDL_CreateWindow NULL -> "Invalid window"
+#else
         SDL_WINDOW_OPENGL | SDL_WINDOW_SHOWN | SDL_WINDOW_RESIZABLE
+#endif
     );
+    if (!wnd) { fprintf(stderr, "ONN: SDL_CreateWindow failed: %s\n", SDL_GetError()); abort(); }
     ctx = SDL_GL_CreateContext(wnd);
+    if (!ctx) { fprintf(stderr, "ONN: SDL_GL_CreateContext failed: %s\n", SDL_GetError()); abort(); }
 
     SDL_GL_SetSwapInterval(configWindow.vsync);
 
