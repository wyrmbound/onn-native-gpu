diff -ru a/onn-pathb/apkrun/apkinstall.sh b/onn-pathb/apkrun/apkinstall.sh
--- a/onn-pathb/apkrun/apkinstall.sh	2026-11-07 17:55:25.507027200 -0400
+++ b/onn-pathb/apkrun/apkinstall.sh	2026-11-07 17:55:25.772251700 -0400
@@ -27,13 +27,13 @@
 [ -n "$ENTRY" ] || { echo "no SDL_main: not an SDL app (engine not supported yet)"; exit 4; }
 ENGINE=sdl2; grep -q 'libSDL3.so' <(for so in "$OUT"/*.so; do needed "$so"; done) && ENGINE=sdl3
 
-# what everything here exports, plus our runtime
-have_lib() { [ -e "$OUT/$1" ] || [ -e "$RT/$1" ] || [ -e "$DIST/$1" ] || [ "$1" = libSDL2.so ] || [ "$1" = libSDL3.so ]; }
+# what everything here exports, plus our runtime (libvulkan.so = our loader shim in pb, vkshim/)
+have_lib() { [ -e "$OUT/$1" ] || [ -e "$RT/$1" ] || [ -e "$DIST/$1" ] || [ "$1" = libSDL2.so ] || [ "$1" = libSDL3.so ] || [ "$1" = libvulkan.so ]; }
 { for so in "$OUT"/*.so "$RT"/*.so "$DIST"/*.so*; do syms --defined-only "$so" | awk '{print $3}'; done; } | sed 's/@.*//' | sort -u > "$W/defined"
 MISSING=$(for so in "$OUT"/*.so; do needed "$so"; done | sort -u | while read -r l; do have_lib "$l" || echo "$l"; done)
 if [ -n "$MISSING" ]; then
   for so in "$OUT"/*.so; do syms --undefined-only "$so" | awk '{print $2}'; done | sed 's/@.*//' | sort -u > "$W/undef"
-  comm -23 "$W/undef" "$W/defined" | grep -v -E '^(SDL_|_ITM|__gmon|_Jv_|__cxa_finalize$)' > "$W/stub_syms" || true
+  comm -23 "$W/undef" "$W/defined" | grep -v -E '^(SDL_|vk[A-Z]|_ITM|__gmon|_Jv_|__cxa_finalize$)' > "$W/stub_syms" || true
   { echo '/* generated by apkinstall: stand-ins for Android libraries our runtime does not have */'
     while read -r s; do echo "long $s(void) { return 0; }"; done < "$W/stub_syms"; } > "$W/stubs.c"
   for l in $MISSING; do
diff -ru a/onnshell/app/src/main/java/com/xplsh/onnshell/data/GameInstaller.kt b/onnshell/app/src/main/java/com/xplsh/onnshell/data/GameInstaller.kt
--- a/onnshell/app/src/main/java/com/xplsh/onnshell/data/GameInstaller.kt	2026-11-07 17:55:25.559977200 -0400
+++ b/onnshell/app/src/main/java/com/xplsh/onnshell/data/GameInstaller.kt	2026-11-07 17:55:25.772251700 -0400
@@ -33,6 +33,8 @@
     private val ID = Regex("[a-z0-9][a-z0-9-]{0,62}")
     /** The APK's own SDL is dropped: our libSDL2/libSDL3 in pb replace it. */
     private val OUR_SDL = setOf("libSDL2.so", "libSDL3.so")
+    /** Our Vulkan loader shim (onn-pathb/vkshim) in pb answers for libvulkan.so: never stub it. */
+    private const val OUR_VULKAN = "libvulkan.so"
 
     enum class Engine { SDL2, SDL3, GAMEMAKER, UNITY, GODOT, OTHER, NONE }
     data class Probe(val engine: Engine, val has32: Boolean, val has64: Boolean) {
@@ -203,7 +205,7 @@
         val entry = elfs.entries.firstOrNull { it.value?.defines("SDL_main") == true }?.key
             ?: error("no SDL_main: not an SDL app")
         val runtime = runtimeLibs()
-        val have = libs.map { it.name }.toSet() + runtime + OUR_SDL
+        val have = libs.map { it.name }.toSet() + runtime + OUR_SDL + OUR_VULKAN
         val missing = elfs.values.filterNotNull().flatMap { it.needed }.toSet() - have
         for (m in missing) stubFor(ctx, m).let { File(stage, m).writeBytes(it) }
         File(stage, "game.json").writeText("""{ "id": "$id", "entry": "${entry.name}", "engine": "$engine" }""" + "\n")
