# Copy to scripts/kit.env and fill in. Every script reads its paths from here; kit.env is git-ignored.
# Plain sh syntax: NAME=value, no spaces around =.

# Build folder for all downloads, sources and outputs (about 30 GB). Use a Linux filesystem path
# (on WSL: inside the distro, not under the Windows drive mount), the builds are much slower otherwise.
WORK=/path/to/onn-work

# Extracted Android NDK r27d folder (needs toolchains/llvm/prebuilt/linux-x86_64/{sysroot,lib/clang}).
# Leave empty and 10-toolchain.sh downloads r27d (664 MB, sha1-checked) into WORK.
NDK=

# Android 14 arm64 GSI zip from Google, for example aosp_arm64-exp-UQ1A.231205.015-11084887-e291b838.zip
# from developer.android.com/topic/generic-system-image/releases (~1 GB). Source of linker64, libc and the HAL libs.
GSI_ZIP=/path/to/aosp_arm64-gsi.zip

# adb on the build host (60/61 push from WORK, so run them where WORK is). "adb" if it is on PATH.
ADB=adb

# The box's network adb address, host:port (Settings > Network on the box shows its IP).
BOX=box-ip-address:5555

# Optional: parallel build jobs (default: all cores).
# JOBS=8
